---
import Layout from '../layouts/Layout.astro';
import TLSAnalyzer from '../components/TLSAnalyzer';
import PQCComparator from '../components/PQCComparator';
---

<Layout title="Lab - Interactive Security Tools | Harshana Moorthy">
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4">Interactive Lab</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Explore hands-on tools for PKI, certificate management, and security analysis. 
          Built to demonstrate real-world capabilities and techniques.
        </p>
      </div>

      <!-- Lab Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <a href="#tls-analyzer" class="bg-white p-6 rounded-lg border-2 border-[#4B00FF] hover:shadow-lg transition-shadow">
          <div class="text-3xl mb-3">🔍</div>
          <h3 class="text-lg font-bold mb-2">TLS Analyzer</h3>
          <p class="text-gray-600 text-sm">
            Analyze domain TLS configuration, certificates, and PQC readiness
          </p>
          <span class="inline-block mt-3 text-[#4B00FF] text-sm font-semibold">
            Active →
          </span>
        </a>

        <a href="#pqc-comparator" class="bg-white p-6 rounded-lg border-2 border-[#4B00FF] hover:shadow-lg transition-shadow">
          <div class="text-3xl mb-3">🔮</div>
          <h3 class="text-lg font-bold mb-2">PQC Algorithm Comparator</h3>
          <p class="text-gray-600 text-sm">
            Compare ML-KEM and ML-DSA vs traditional algorithms
          </p>
          <span class="inline-block mt-3 text-[#4B00FF] text-sm font-semibold">
            Active →
          </span>
        </a>

        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 opacity-60">
          <div class="text-3xl mb-3">📊</div>
          <h3 class="text-lg font-bold mb-2">Certificate Chain Visualizer</h3>
          <p class="text-gray-600 text-sm">
            Interactive dependency graph of certificate relationships
          </p>
          <span class="inline-block mt-3 text-gray-500 text-sm font-semibold">
            Coming Soon
          </span>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 opacity-60">
          <div class="text-3xl mb-3">🤖</div>
          <h3 class="text-lg font-bold mb-2">SE Agent</h3>
          <p class="text-gray-600 text-sm">
            AI-powered SE assistant with RFP analysis and POC guidance
          </p>
          <span class="inline-block mt-3 text-gray-500 text-sm font-semibold">
            Coming Soon
          </span>
        </div>
      </div>

      <!-- Active Tool Section -->
      <div id="tls-analyzer" class="scroll-mt-20 mb-16">
        <TLSAnalyzer client:load />
      </div>

      <!-- PQC Comparator Section -->
      <div id="pqc-comparator" class="scroll-mt-20">
        <PQCComparator client:load />
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section class="py-16 bg-[#EFE9E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-8 text-center">Built With</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <div class="px-4 py-2 bg-white rounded-lg border border-gray-200">
          <span className="font-semibold">Astro</span>
        </div>
        <div class="px-4 py-2 bg-white rounded-lg border border-gray-200">
          <span className="font-semibold">React</span>
        </div>
        <div class="px-4 py-2 bg-white rounded-lg border border-gray-200">
          <span className="font-semibold">Cloudflare Pages</span>
        </div>
        <div class="px-4 py-2 bg-white rounded-lg border border-gray-200">
          <span className="font-semibold">Cloudflare Workers</span>
        </div>
        <div class="px-4 py-2 bg-white rounded-lg border border-gray-200">
          <span className="font-semibold">TypeScript</span>
        </div>
        <div class="px-4 py-2 bg-white rounded-lg border border-gray-200">
          <span className="font-semibold">Tailwind CSS</span>
        </div>
      </div>
      <p class="text-center text-gray-600 mt-6">
        Each tool is designed to be extensible and production-ready. More projects coming soon.
      </p>
    </div>
  </section>
</Layout>
