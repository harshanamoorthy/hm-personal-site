---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Harshana Moorthy - Solutions Engineering Leader">
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-[#4B00FF] to-[#FF3827] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-3xl">
        <h1 class="text-5xl font-bold mb-6">
          Building the Future of Machine Identity Management
        </h1>
        <p class="text-xl mb-8 text-gray-100">
          VP of Solution Engineering at AppViewX, leading global teams across PKI, CLM, 
          Post-Quantum Cryptography, and machine identity at scale.
        </p>
        <div class="flex gap-4">
          <a href="/lab" class="bg-white text-[#4B00FF] px-6 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors">
            Explore Lab
          </a>
          <a href="/experience" class="border-2 border-white text-white px-6 py-3 rounded-lg font-bold hover:bg-white hover:text-[#4B00FF] transition-colors">
            View Experience
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 bg-[#EFE9E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-[#4B00FF]">10+</div>
          <div class="text-gray-600 mt-2">Years at AppViewX</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#4B00FF]">$60M</div>
          <div class="text-gray-600 mt-2">Team ARR</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#4B00FF]">80%</div>
          <div class="text-gray-600 mt-2">POC-to-Close Rate</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#4B00FF]">14</div>
          <div class="text-gray-600 mt-2">Global SE Team Members</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-12 text-center">Domain Expertise</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white p-6 rounded-lg border border-gray-200 hover:border-[#4B00FF] transition-colors">
          <div class="text-4xl mb-4">🔐</div>
          <h3 class="text-xl font-bold mb-3">PKI & CLM</h3>
          <p class="text-gray-600">
            Certificate Lifecycle Management at enterprise scale. ACME, EST, SCEP, CMP protocols. 
            ADCS, cloud PKI, HSM integration.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-gray-200 hover:border-[#4B00FF] transition-colors">
          <div class="text-4xl mb-4">🔮</div>
          <h3 class="text-xl font-bold mb-3">Post-Quantum Cryptography</h3>
          <p class="text-gray-600">
            ML-KEM, ML-DSA implementation. NIST FIPS 203/204/205 compliance. 
            Quantum-safe TLS and hybrid certificate strategies.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-gray-200 hover:border-[#4B00FF] transition-colors">
          <div class="text-4xl mb-4">☁️</div>
          <h3 class="text-xl font-bold mb-3">Cloud & Kubernetes</h3>
          <p class="text-gray-600">
            cert-manager orchestration, service mesh security, code signing at scale, 
            IoT device certificate management.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-gray-200 hover:border-[#4B00FF] transition-colors">
          <div class="text-4xl mb-4">🤖</div>
          <h3 class="text-xl font-bold mb-3">AI Practitioner</h3>
          <p class="text-gray-600">
            Claude API integration, agentic workflows, enterprise AI adoption. 
            SE Agent, productivity tools, and AI-powered automation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Explore?</h2>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Check out my interactive lab to see some of the tools I've built in action.
      </p>
      <a href="/lab" class="bg-[#4B00FF] text-white px-8 py-3 rounded-lg font-bold hover:bg-[#3a00cc] transition-colors inline-block">
        Visit the Lab
      </a>
    </div>
  </section>
</Layout>
