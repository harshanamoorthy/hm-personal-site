---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Insights - Harshana Moorthy">
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold mb-8">Insights</h1>
      
      <div class="bg-[#EFE9E1] p-12 rounded-lg text-center">
        <div class="text-6xl mb-6">📝</div>
        <h2 class="text-2xl font-bold mb-4">Coming Soon</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          This section will feature articles, case studies, and thought leadership on PKI, 
          certificate lifecycle management, post-quantum cryptography, and solution engineering best practices.
        </p>
      </div>

      <div class="mt-12">
        <h2 class="text-2xl font-bold mb-6">Planned Topics</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg border border-gray-200">
            <h3 class="font-bold text-lg mb-2">Post-Quantum PKI Strategies</h3>
            <p class="text-gray-600 text-sm">
              Practical approaches to quantum-safe certificate migration for enterprises
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg border border-gray-200">
            <h3 class="font-bold text-lg mb-2">Building SE Teams at Scale</h3>
            <p class="text-gray-600 text-sm">
              Lessons from growing a global solution engineering organization
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg border border-gray-200">
            <h3 class="font-bold text-lg mb-2">IoT Certificate Management</h3>
            <p class="text-gray-600 text-sm">
              Automating certificate lifecycle for 50K+ connected devices
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg border border-gray-200">
            <h3 class="font-bold text-lg mb-2">Enterprise PKI Architecture Patterns</h3>
            <p class="text-gray-600 text-sm">
              Common patterns and anti-patterns in large-scale certificate management
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
